# Mindlap Clinical EMR - Production Environment Configuration Reference

# 1. Django Core Security
DEBUG=False
SECRET_KEY=generate-a-long-random-50-character-secret-key-here
ADMIN_PASSWORD=SetYourVeryStrongAdminPassword2026!

# 2. Domain & Host Access Control
ALLOWED_HOSTS=your-domain.com,www.your-domain.com,127.0.0.1

# 3. CORS Policy Origins
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# 4. PostgreSQL Database Configuration
DB_ENGINE=django.db.backends.postgresql
DB_NAME=mindlap_db
DB_USER=mindlap_user
DB_PASSWORD=SetYourVeryStrongDatabasePassword2026!
DB_HOST=db
DB_PORT=5432

# 5. HTTPS Security Headers
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# 6. Database Reset Override (Default: False to protect live logs & patient data)
RESET_DEMO_DATA=False
